@Metadata.layer: #CORE
@UI: {
        headerInfo: { typeName: 'Connection',
                      typeNamePlural: 'Connections',
                      title: { type: #STANDARD, value: 'ConnectionId' }},
        presentationVariant: [ { visualizations: [ { type: #AS_LINEITEM } ] } ]
    }


annotate entity ZC_Connection_R with

{

  @UI.facet: [
      {
        id:              'Connection',
        purpose:         #STANDARD,
        type:            #COLLECTION,
        label:           'Connection',
        position:        10
      },
          {
            id:              'General',
            targetQualifier: 'General_FG',
            parentId:        'Connection',
            purpose:         #STANDARD,
            type:            #FIELDGROUP_REFERENCE,
            label:           'General',
            position:        10
          },
          {
            id:              'Departure',
            targetQualifier: 'Departure_FG',
            parentId:        'Connection',
            purpose:         #STANDARD,
            type:            #FIELDGROUP_REFERENCE,
            label:           'Departure',
            position:        20
          },
          {
            id:              'Destination',
            targetQualifier: 'Destination_FG',
            parentId:        'Connection',
            purpose:         #STANDARD,
            type:            #FIELDGROUP_REFERENCE,
            label:           'Destination',
            position:        30
          }, 
      { 
        id:     'Flight',
        purpose:  #STANDARD,
        type:     #LINEITEM_REFERENCE,
        label:    'Flight',
        position: 20,
        targetElement: '_Flight' }
    ]

  @UI.lineItem: [ { position: 10 } ]
  @UI.selectionField: [{ position: 10 }]
  @EndUserText.quickInfo: 'Airline that operates the flight connection'
  @UI.fieldGroup: [{ position: 10, qualifier: 'General_FG' }]

        
  AirlineID;

  @UI.lineItem: [ { position: 20 } ]
  @UI.selectionField: [{ position: 20 }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'General_FG' }]
  ConnectionId;

  @UI.fieldGroup: [{ position: 30, qualifier: 'General_FG' }]
  Distance;

  @UI.fieldGroup: [{ position: 40, qualifier: 'General_FG', label: 'Distance Unit' }]
  DistanceUnit;

  @UI.lineItem: [ { position: 30 } ] 
  @UI.selectionField: [{ position: 30 }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'Departure_FG' }]
  DepartureAirport;


  @UI.fieldGroup: [{ position: 20, qualifier: 'Departure_FG' }]
  @UI.lineItem: [ { position: 50 } ]
  DepartureTime;
  
  @UI.lineItem: [ { position: 40 } ]
  @UI.selectionField: [{ position: 40 }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'Destination_FG' }]  
  DestinationAirport;

  @UI.lineItem: [ { position: 60 } ]
  @ UI.fieldGroup: [{ position: 20, qualifier: 'Destination_FG' }]  
  ArrivalTime;

}